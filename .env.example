# =====================================================================
# Supabase 환경변수
# Supabase Dashboard → Project Settings → API 에서 복사
# =====================================================================

# Project URL (예: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# anon public key (브라우저에서 사용 가능, RLS로 보호됨)
SUPABASE_KEY=

# =====================================================================
# Web3Forms — Contact 폼 → 담당자 이메일 자동 발송
# https://web3forms.com 에서 받을 이메일(kjin137@naver.com) 입력 → access key 발급
# access key는 공개돼도 안전(정적 사이트용 설계)
# =====================================================================
NUXT_PUBLIC_WEB3FORMS_KEY=

# (선택) service_role key — 절대 클라이언트로 노출 금지
# 서버사이드 작업이 필요할 때만 사용
# SUPABASE_SERVICE_KEY=
