# =====================================================================
# Supabase 환경변수
# Supabase Dashboard → Project Settings → API 에서 복사
# =====================================================================

# Project URL (예: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=

# anon public key (브라우저에서 사용 가능, RLS로 보호됨)
SUPABASE_KEY=

# =====================================================================
# EmailJS — Contact 폼 → 담당자 이메일 자동 발송
# https://dashboard.emailjs.com/admin
# =====================================================================
NUXT_PUBLIC_EMAILJS_SERVICE_ID=
NUXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NUXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# (선택) service_role key — 절대 클라이언트로 노출 금지
# 서버사이드 작업이 필요할 때만 사용
# SUPABASE_SERVICE_KEY=
